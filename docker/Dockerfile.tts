# 中文語音合成用的環境：edge-tts（線上，台灣腔原生）＋ F5-TTS（本地，zero-shot
# voice cloning）。兩個各自一個 venv——F5-TTS 拖著 torch 一整串相依，跟輕量的
# edge-tts 混在一起會互相牽制。
#
# 本機沒有 NVIDIA GPU，所以 torch 裝 CPU 版（+cpu 的 index-url 不能省，
# 否則會抓 CUDA 版，多下載 2 GB 而且用不到）。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip ffmpeg curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# ---- edge-tts（輕）----
RUN python3 -m venv /opt/edge && /opt/edge/bin/pip install --no-cache-dir \
    edge-tts numpy

# ---- F5-TTS（重）----
RUN python3 -m venv /opt/f5 && /opt/f5/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/f5/bin/pip install --no-cache-dir torch torchaudio \
        --index-url https://download.pytorch.org/whl/cpu && \
    /opt/f5/bin/pip install --no-cache-dir f5-tts

# 模型先抓進 image，免得每次跑都重下 1.3 GB
ENV HF_HOME=/opt/hf
RUN /opt/f5/bin/python - <<'PY'
from huggingface_hub import hf_hub_download
for repo, fn in [("SWivid/F5-TTS", "F5TTS_v1_Base/model_1250000.safetensors"),
                 ("SWivid/F5-TTS", "F5TTS_v1_Base/vocab.txt")]:
    p = hf_hub_download(repo, fn)
    print("cached:", p)
PY

WORKDIR /w
