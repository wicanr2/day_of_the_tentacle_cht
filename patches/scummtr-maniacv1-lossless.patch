+#ifdef SCUMMTR_PRESERVE_DUP_INDEX_ENTRIES
+void TableOfContent::suppressOffset(int id)
+{
+	if (!_idInRange(id))
+		return;
+
+	bool known = false;
+	for (size_t i = 0; i < _suppressedOffsets.size(); ++i)
+		if (_suppressedOffsets[i].first == id)
+		{
+			known = true;
+			break;
+		}
+
+	if (!known)
+		_suppressedOffsets.push_back(std::make_pair(id, _toc[id].offset));
+
+	_toc[id].offset = -1;
+}
+
+void TableOfContent::_restoreSuppressedOffsets()
+{
+	for (size_t i = 0; i < _suppressedOffsets.size(); ++i)
+		if (_idInRange(_suppressedOffsets[i].first))
+			_toc[_suppressedOffsets[i].first].offset = _suppressedOffsets[i].second;
+}
+
+void TableOfContent::_reapplySuppressedOffsets()
+{
+	for (size_t i = 0; i < _suppressedOffsets.size(); ++i)
+		if (_idInRange(_suppressedOffsets[i].first))
+			_toc[_suppressedOffsets[i].first].offset = -1;
+}
+#endif
+
