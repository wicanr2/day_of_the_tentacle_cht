 void GlobalRoomIndex::save(FilePart &file, GlobalTocFormat format, bool fixedSize)
 {
 	// hack for V1
 	if (fixedSize) // means V1
+	{
+#ifdef SCUMMTR_PRESERVE_V1_ROOM_OFFSETS
+		if ((int)_v1OrigOffsets.size() == _size)
+		{
+			for (int i = 0; i < _size; ++i)
+				_toc[i].offset = _v1OrigOffsets[i];
+
+			TableOfContent::save(file, format, fixedSize);
+
+			// 還原內部模型，之後若再被讀到，行為與未開此開關時一致
+			for (int i = 0; i < _size; ++i)
+				_toc[i].offset = 0;
+			return;
+		}
+#endif
 		TableOfContent::save(file, format, fixedSize);
+	}
 }
 
