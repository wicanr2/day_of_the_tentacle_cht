# 交叉編 Windows 版 ScummVM（只開 SCUMM 引擎）用的工具鏈。
#
# 為什麼要自己編 libogg / libFLAC：DOTT CD 的語音包 monster.sof 是 FLAC 壓縮，
# ScummVM 沒有 USE_FLAC 就讀不出來——**不會報錯**，只是整片語音消失。
# Ubuntu 套件庫沒有 mingw 版的這兩個，只能從原始碼編。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ARG SDLVER=2.30.9
ARG OGGVER=1.3.5
ARG FLACVER=1.4.3

RUN apt-get update && apt-get install -y --no-install-recommends \
    mingw-w64 mingw-w64-tools \
    build-essential cmake pkg-config nasm git curl file ca-certificates \
    python3 zip unzip zstd xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV PREFIX=/usr/x86_64-w64-mingw32
ENV HOST=x86_64-w64-mingw32

# ---- SDL2（官方 mingw devel 包）----
RUN cd /tmp && \
    curl -fsSL -o sdl.tar.gz \
      "https://github.com/libsdl-org/SDL/releases/download/release-${SDLVER}/SDL2-devel-${SDLVER}-mingw.tar.gz" && \
    tar xf sdl.tar.gz && \
    cp -r SDL2-${SDLVER}/x86_64-w64-mingw32/* "$PREFIX/" && \
    rm -rf /tmp/*

# ---- libogg → libFLAC（順序不能反，FLAC 的 configure 會找 ogg）----
RUN cd /tmp && \
    curl -fsSL -o ogg.tar.gz "https://downloads.xiph.org/releases/ogg/libogg-${OGGVER}.tar.gz" && \
    tar xf ogg.tar.gz && cd libogg-${OGGVER} && \
    ./configure --host=$HOST --prefix="$PREFIX" --enable-static --disable-shared && \
    make -j"$(nproc)" && make install && \
    rm -rf /tmp/*

RUN cd /tmp && \
    curl -fsSL -o flac.tar.xz "https://downloads.xiph.org/releases/flac/flac-${FLACVER}.tar.xz" && \
    tar xf flac.tar.xz && cd flac-${FLACVER} && \
    ./configure --host=$HOST --prefix="$PREFIX" --enable-static --disable-shared \
        --disable-programs --disable-examples --disable-doxygen-docs \
        --disable-ogg && \
    make -j"$(nproc)" && make install && \
    rm -rf /tmp/*

# ---- zlib（ScummVM 的存檔壓縮）----
RUN cd /tmp && \
    curl -fsSL -o zlib.tar.gz "https://zlib.net/fossils/zlib-1.3.1.tar.gz" && \
    tar xf zlib.tar.gz && cd zlib-1.3.1 && \
    make -f win32/Makefile.gcc BINARY_PATH="$PREFIX/bin" INCLUDE_PATH="$PREFIX/include" \
        LIBRARY_PATH="$PREFIX/lib" PREFIX=${HOST}- -j"$(nproc)" && \
    make -f win32/Makefile.gcc install BINARY_PATH="$PREFIX/bin" \
        INCLUDE_PATH="$PREFIX/include" LIBRARY_PATH="$PREFIX/lib" PREFIX=${HOST}- && \
    rm -rf /tmp/*

WORKDIR /w
